# APP_URL: The public URL of your deployed site (no trailing slash)
APP_URL="https://your-project.vercel.app"

# DISCORD_CLIENT_ID: Client ID from Discord Developer Portal
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"

# DISCORD_CLIENT_SECRET: Client Secret from Discord Developer Portal
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"

# DISCORD_ALLOWED_USERS: Comma-separated list of Discord usernames or User IDs allowed to access the admin panel
DISCORD_ALLOWED_USERS="your_discord_username"

# ADMIN_SESSION_SECRET: Random secret string used to sign admin session tokens (use a long random string)
ADMIN_SESSION_SECRET="your-super-secret-random-string"

# Cloudinary credentials (used for image uploads and portfolio JSON storage)
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"
